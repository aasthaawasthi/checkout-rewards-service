{
  "info": {
    "name": "Checkout & Rewards Service",
    "description": "All endpoints. Run top to bottom: requests save cartId, orderId and couponCode into collection variables. Start the server with ORDER_MILESTONE_N=1 to get a coupon after the first order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "cartId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "couponCode",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.headers.has('Idempotency-Key') && !pm.collectionVariables.get('idempotencyKey')) {",
          "  pm.collectionVariables.set('idempotencyKey', 'pm-' + pm.variables.replaceIn('{{$guid}}'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/p-sneakers-ltd",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "p-sneakers-ltd"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Carts",
      "item": [
        {
          "name": "Create cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('cartId', pm.response.json().id);",
                  "pm.collectionVariables.set('idempotencyKey', '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts"
              ]
            }
          }
        },
        {
          "name": "Add item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"p-jeans\",\n  \"quantity\": 2\n}"
            }
          }
        },
        {
          "name": "Add second item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"p-cap\",\n  \"quantity\": 1\n}"
            }
          }
        },
        {
          "name": "Add item already in cart (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"p-jeans\",\n  \"quantity\": 2\n}"
            }
          }
        },
        {
          "name": "Add invalid quantity (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"p-tshirt\",\n  \"quantity\": \"2\"\n}"
            }
          }
        },
        {
          "name": "Update quantity",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/items/p-jeans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "items",
                "p-jeans"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}"
            }
          }
        },
        {
          "name": "Remove item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/items/p-cap",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "items",
                "p-cap"
              ]
            }
          }
        },
        {
          "name": "View cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}"
              ]
            }
          }
        },
        {
          "name": "Accept current prices",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/accept-current-prices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "accept-current-prices"
              ]
            },
            "description": "Use after checkout returns 409 PRICE_CHANGED."
          }
        }
      ]
    },
    {
      "name": "Checkout & orders",
      "item": [
        {
          "name": "Checkout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) pm.collectionVariables.set('orderId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "description": "Reuse the same value when retrying"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "description": "Send twice: the second call returns 200 with Idempotent-Replayed: true and the same order."
          }
        },
        {
          "name": "Checkout with coupon",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) pm.collectionVariables.set('orderId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "description": "Reuse the same value when retrying"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"couponCode\": \"{{couponCode}}\"\n}"
            }
          }
        },
        {
          "name": "Checkout with simulated payment decline (402)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "description": "Reuse the same value when retrying"
              },
              {
                "key": "X-Simulate-Payment",
                "value": "decline"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Generate coupon",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('couponCode', pm.response.json().coupon.code);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "coupons"
              ]
            }
          }
        },
        {
          "name": "List coupons",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "coupons"
              ]
            }
          }
        },
        {
          "name": "Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/report",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "report"
              ]
            }
          }
        },
        {
          "name": "Change product price",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/products/p-jeans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "products",
                "p-jeans"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unitPricePaise\": 139999\n}"
            }
          }
        },
        {
          "name": "Change product stock",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/products/p-sneakers-ltd",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "products",
                "p-sneakers-ltd"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 3\n}"
            }
          }
        }
      ]
    }
  ]
}
